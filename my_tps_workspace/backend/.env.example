# Backend Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=3001
NODE_ENV=development

# Database (SQLite)
DB_PATH=./data/tps.db

# File Storage
UPLOAD_DIR=./uploads

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
HMAC_SECRET=your-hmac-secret-for-file-downloads-change-in-production
# Auth switch: false enforces JWT auth (login required, 401 without session).
# true keeps development friction-free (every request runs as the dev user).
AUTH_DISABLED=true

# CORS
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed origins (overrides FRONTEND_URL)
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Signed download URLs (viewer loads every CT slice through one)
# Lifetime in seconds, default 900. Raise it for dev sessions longer than 15 min.
SIGNED_URL_EXPIRY_SECONDS=900

# Logging
LOG_LEVEL=info

# AI Contouring Service (Phase 4)
AI_CONTOURING_ENDPOINT=http://localhost:8080/segment
